{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Adi-Vritti scheme rule file",
  "type": "object",
  "required": ["scheme", "scheme_name", "academic_year", "category", "ministry", "portal", "rules", "award"],
  "properties": {
    "scheme": { "type": "string" },
    "scheme_name": { "type": "string" },
    "academic_year": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
    "category": { "type": "string", "enum": ["welfare", "merit"] },
    "ministry": { "type": "string" },
    "portal": { "type": "string" },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "op", "onFail"],
        "properties": {
          "claim": { "type": "string" },
          "op": { "type": "string", "enum": ["in", "lte", "gte", "eq", "exists"] },
          "value": {},
          "onFail": { "type": "string" }
        }
      }
    },
    "award": { "type": "object" }
  }
}
