# BFF upstream config (server-only: never use NEXT_PUBLIC_ for the token).
# Local demo: AI_SERVICE_TOKEN must match the ai service's token and the ai
# service needs ALLOW_INSECURE_DEV=true while the published dev value is used.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=dev-only-ai-service-token

# Signs the officer console's session cookie (HS256, 8h). The guard in
# src/proxy.ts verifies the signature and the expiry, so this value decides
# whether /dashboard is reachable. REQUIRED in production: with it unset, no
# session is ever minted and every cookie is rejected, so the console shows a
# login page that cannot succeed. Unset in development falls back to a
# published dev value, which is a session and not authentication.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OFFICER_SESSION_SECRET=

# 0 disables the one-click demo entry. Development only; production always
# refuses a demo session regardless of this value.
OFFICER_CONSOLE_DEMO=1
