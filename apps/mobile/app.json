{
  "expo": {
    "name": "Adi-Vritti",
    "slug": "adi-vritti",
    "scheme": "adivritti",
    "icon": "./assets/icon.png",
    "platforms": ["ios", "android", "web"],
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-asset",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ],
      "./plugins/withComposeSuppression.js"
    ],
    "android": {
      "package": "in.gov.mota.adivritti"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "decb5f03-15e7-4626-9566-59d4cf8ba605"
      }
    }
  }
}
